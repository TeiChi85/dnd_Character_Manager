# OS / editor cruft
Thumbs.db
.DS_Store
desktop.ini
*.swp
*~

# scratch / temp
scratchpad/
*.tmp
__pycache__/
*.pyc

# homebrew books live outside the repo; ignore any dropped in by mistake
homebrew/

# zipped copies of the app, kept here on purpose to hand to other players.
# They are a package, not source, so they stay out of the repo.
*.zip

# working copies of saved characters and their portraits, gathered here for convenience
Characters/

# credentials for the upload hook. Never committed, never packaged: a token in the
# public mirror or in the zip handed to other players would be a token given away.
dropbox.*
*.accesstoken
*.refreshtoken
*.verifier

# Azure deployment is personal infrastructure, kept out of the repository. It holds
# subscription and tenant ids and is of no use to anyone else.
tools/deploy-azure.ps1

# Local development, private files and credentials
.venv/
venv/
.vscode/
.idea/
.codex/
*.code-workspace
.env
.env.*
*.local
*.log
*.bak
*.pem
*.key
local/
private/
secrets/
characters/
portraits/
.pytest_cache/
.ruff_cache/
node_modules/
/server/.venv/
/server/storage/
/instance/
*.json.tmp
backups/
trash/
character-storage/

# Raw rules, homebrew and character exports: conservative default for all JSON.
# Add a narrowly scoped exception only for reviewed, redistributable source fixtures.
*.json
*.jsonl
*.pdf
*.7z
*.rar
*.tar
*.gz
5etools*/
data/
rule-data/

# resources contains local generated rules and optional PDF payloads.
# Allow only the original redistributable source assets; new assets need review.
/resources/*
!/resources/pdf-fields.js
!/resources/logo.png
!/resources/favicon.ico
!/resources/favicon-32.png
!/resources/apple-touch-icon.png
!/resources/dnd-classes.png
!/resources/dnd-species.png
!/resources/dnd-spells.png
!/resources/dnd-creatures.png
!/resources/dnd-feats.png
!/resources/dnd-items.png
